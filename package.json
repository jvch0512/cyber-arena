{
  "name": "cyber-arena",
  "version": "1.0.0",
  "description": "Autonomous red team against blue team on a simulated enterprise network. Deterministic, partial information, pluggable agents, replay UI and tournament leaderboard. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "bin": { "cyber-arena": "dist/src/cli.js" },
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/src/server-main.js",
    "test": "tsc && node --test dist/test/*.test.js"
  },
  "repository": "github:jvch0512/cyber-arena",
  "keywords": ["red-team", "blue-team", "simulation", "cyber-range", "autonomous-agents", "detection-engineering", "ai-security", "typescript"],
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0" },
  "engines": { "node": ">=20" }
}
